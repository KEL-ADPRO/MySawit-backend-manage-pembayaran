# Copy ke .env (di folder ini) lalu isi dengan kredensial Grafana Cloud kamu.
# JANGAN commit file .env (sudah otomatis di-ignore).

# Target yang akan di-scrape oleh Alloy (app kamu).
#   - EB staging (default): Mysawit-pembayaran-env.eba-2dhq8pfw.us-east-1.elasticbeanstalk.com:80
#   - Local dev:            host.docker.internal:8085
MYSAWIT_APP_TARGET=Mysawit-pembayaran-env.eba-2dhq8pfw.us-east-1.elasticbeanstalk.com:80

# Dari Grafana Cloud → Connections → Hosted Prometheus metrics → "Send metrics"
GRAFANA_CLOUD_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-ap-southeast-1.grafana.net/api/prom/push
GRAFANA_CLOUD_USERNAME=1234567
GRAFANA_CLOUD_API_TOKEN=glc_eyJ...
